DATABASE_URL=postgresql+asyncpg://flagstone:flagstone@localhost:5432/flagstone_dev
# Seeded as an SDK key of the Default project. Create more keys per project in the UI.
SDK_KEY=sdk-dev-key

# URL the browser uses for the admin UI. OAuth callbacks are {PUBLIC_URL}/auth/{provider}/callback
PUBLIC_URL=http://localhost:5173
# true whenever the UI is served over HTTPS
COOKIE_SECURE=false

# Comma-separated emails that become admins of the Default project on sign-in
ADMIN_EMAILS=admin@example.com

# Configure any of these; only configured providers appear on the login page
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Passwordless sign-in by email. Local development only.
DEV_LOGIN=false
